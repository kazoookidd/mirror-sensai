# Ollama model to use (must be pulled beforehand with `ollama pull MODEL`)
MODEL=llama3

# Base URL of the local Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Path to the system prompt file, relative to the project root
SYSTEM_PROMPT_PATH=system_prompt.txt

# RAG chunking: chunk size and overlap between chunks, in estimated tokens (~4 chars/token)
RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP=50

# RAG embeddings: Ollama model used to embed chunks and questions
# (pull it first: ollama pull nomic-embed-text)
RAG_EMBED_MODEL=nomic-embed-text

# RAG retrieval: a chunk is used only if its similarity is at least RAG_MIN_SCORE (0 to 1),
# and at most RAG_TOP_K chunks are added to a question
RAG_MIN_SCORE=0.70
RAG_TOP_K=3

BRAVE_SEARCH_API_KEY=ta_cle_brave
TAVILY_API_KEY=ta_cle_tavily
EXA_API_KEY=ta_cle_exa

# --- Token limit ---
# block    : refuse the message when the context is over CONTEXT_TOKEN_BUDGET
#            even after compression (default)
# continue : send it anyway, with a warning
TOKEN_LIMIT_ACTION=block
# Show the small token usage line under each answer (true/false)
SHOW_TOKEN_USAGE=true

# --- Generation ---
# Sampling temperature of the chat answers: 0 (deterministic) to 2 (creative).
# Leave empty to use the model's own default. Change it at runtime with /temperature.
TEMPERATURE=0.2
# The user never asks for tools: the model decides. A message that needs no tool
# costs ONE model call. Needs a model with tool support (llama3.1, qwen2.5...).
AGENT_TOOLS=true
# Maximum model calls for one answer (tool rounds + final answer)
AGENT_MAX_STEPS=4
# Show a dimmed line for each tool used ("Searching the web: ...")
AGENT_SHOW_ACTIVITY=true
# Tool declarations (JSON), relative to the project root or absolute
# AGENT_TOOLS_PATH=src/Tools/tools.json
